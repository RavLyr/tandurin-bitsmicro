# Tanduri environment variables — see docs/ARCHITECTURE.md §7.
# Copy to .env.local and fill real values. NEVER commit .env.local.

# --- Supabase (project dashboard: Settings -> API Keys) ---
# Publishable key: client-visible, RLS-guarded reads/writes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (server-only!): server writes, cron, storage admin. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Google Gemini (https://aistudio.google.com/apikey) ---
# Server-only. Model default: gemini-2.5-flash (budget-conscious, NFR-09).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenWeatherMap (https://home.openweathermap.org/api_keys) ---
# Server-only. weather_lookup tool, ~1,000 free req/day.
OPENWEATHER_API_KEY=

# --- Resend (https://resend.com/api-keys) ---
# Server-only. Email reminders (F-09). Free tier: 100/day.
RESEND_API_KEY=

# --- Cron guard ---
# Server-only. Vercel Cron invokes /api/cron/reminders with header CRON_SECRET.
# Generate: openssl rand -hex 32
CRON_SECRET=

# --- App URL ---
# Client-visible. Absolute links in emails + redirects (local dev: http://localhost:3000).
NEXT_PUBLIC_APP_URL=http://localhost:3000
